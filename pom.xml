<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      parent 引入 Spring Boot 的依赖与插件管理。
      作用是：子依赖可以不用写版本号，由 parent 统一管控，避免版本冲突。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!-- 本项目坐标：groupId(组织) + artifactId(项目名) + version -->
    <groupId>com.example</groupId>
    <artifactId>vue3-server</artifactId>
    <version>1.0.0</version>
    <name>vue3-server</name>
    <description>Vue3 用户管理后端：Spring Boot + MyBatis-Plus + MySQL</description>

    <properties>
        <!-- 使用你已安装的 Java 21 -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web 场景启动器：内嵌 Tomcat + Spring MVC，提供 REST 接口能力 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          MyBatis-Plus 的 Spring Boot 3 专用启动器（注意是 spring-boot3 版本）。
          它基于 MyBatis，额外提供：BaseMapper 内置 CRUD、分页插件、条件构造器等。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.7</version>
        </dependency>

        <!-- MySQL 驱动（runtime 表示编译期不需要，运行/打包时才用） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway：数据库版本迁移工具，应用启动时自动按版本顺序执行 db/migration 下的 SQL -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Flyway 的 MySQL 支持（Flyway 9.x 起 MySQL 驱动拆分为独立模块，必须单独引入，否则报 Unsupported Database: MySQL 8.0） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- Lombok：用注解自动生成 getter/setter/toString 等，减少样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试启动器（可选，用于写单元测试） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot 打包插件：把项目打成可执行的 fat-jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Lombok 在编译期工作，打包时排除它 -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
