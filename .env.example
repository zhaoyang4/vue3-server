# ============================================================
# docker compose 的环境变量模板（本文件可入库，因为不含真实密码）
#
# 使用：
#   cp .env.example .env
#   然后把下面的占位值改成真实值（.env 已在 .gitignore 里，永远不会被提交）
#
# 这些值会被 docker-compose.yml 里的 ${VAR} 读取，再注入到容器的环境变量，
# 最终被 application-prod.yml 的 ${DB_PASSWORD} 之类占位符消费。
# 一条链路：.env -> compose -> 容器环境变量 -> Spring 配置
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=改成一个强密码
DB_NAME=vue3_user
DB_USERNAME=app_user
DB_PASSWORD=改成另一个强密码
# 宿主机上映射 MySQL 的端口（只绑定 127.0.0.1，不对公网开放）
MYSQL_LOCAL_PORT=3306

# ---- 后端 ----
# JWT 签名密钥，至少 32 位随机串。生成：openssl rand -base64 48
JWT_SECRET=请替换为随机生成的长密钥请替换为随机生成的长密钥
# 允许跨域的前端地址（同域 Nginx 反代时用不到，留着兜底）
CORS_ALLOWED_ORIGINS=http://localhost
# 宿主机上映射后端端口（只绑 127.0.0.1；要公网直连就改 docker-compose.yml 的 ports）
BACKEND_LOCAL_PORT=8080

# ---- 前端 ----
# 对外访问端口。80 被占用就改 8000，然后访问 http://IP:8000
WEB_PORT=80
# 前端构建时写入的接口地址。/api = 走 Nginx 同源反代（推荐）
VITE_API_BASE=/api
# 前端项目所在目录（相对于本文件）。默认同级的 ../vue3
FRONTEND_DIR=../vue3
