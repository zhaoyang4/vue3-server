# ============================================================
# app.sh 读取的环境变量文件模板（配置外置的载体）
#
# 用法：
#   cp env.sh.example env.sh
#   vim env.sh            填真实值
#   chmod 600 env.sh      只有自己能读（里面有数据库密码）
#
# ⚠ env.sh 不要提交到 Git（后端 .gitignore 已忽略 .env*，此处请自行确认）
# ============================================================

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vue3_user
DB_USERNAME=app_user
DB_PASSWORD=改成真实密码

# ---- 安全 ----
# 生成：openssl rand -base64 48
JWT_SECRET=改成随机长密钥
JWT_EXPIRE_MINUTES=120

# ---- 跨域：填前端访问地址；用 Nginx 同域反代时填域名即可 ----
CORS_ALLOWED_ORIGINS=http://你的域名或IP

# ---- 日志 ----
LOG_FILE=./logs/vue3-server.log
LOG_LEVEL_APP=info
